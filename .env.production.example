# Production Environment Variables for Render

APP_NAME=VeriCertis
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://vericertis-backend.onrender.com

# Frontend URL (Vercel)
FRONTEND_URL=https://vericertis-frontend.vercel.app

# CORS - Autorisez votre frontend Vercel
CORS_ALLOWED_ORIGINS=https://vericertis-frontend.vercel.app,http://localhost:3000

# Database (à configurer depuis Render Dashboard)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DATABASE_URL=

# Cache & Session
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database

# Logs
LOG_CHANNEL=stack
LOG_LEVEL=info

# Mail (à configurer si besoin)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@vericertis.com
MAIL_FROM_NAME="${APP_NAME}"

# Blockchain (optionnel)
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK=ethereum

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Session
SESSION_LIFETIME=120
SESSION_DOMAIN=.vericertis.com
SESSION_SECURE_COOKIE=true

# Sanctum
SANCTUM_STATEFUL_DOMAINS=vericertis-frontend.vercel.app,localhost:3000
