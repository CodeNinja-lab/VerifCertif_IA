# Configuration de l'API IA (FastAPI pour embeddings)
AI_API_URL=http://localhost:8000
AI_API_TIMEOUT=30

# Configuration PostgreSQL pour les embeddings (pgvector)
# Note: Utilisez la même base que DB_CONNECTION ou une base séparée
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_DATABASE=verifcertis_embeddings
PGSQL_USERNAME=postgres
PGSQL_PASSWORD=
